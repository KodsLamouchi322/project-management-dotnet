@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - monprojet.NET</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--color-bg);padding:16px;">
        <div style="width:100%;max-width:420px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:28px;animation:authFadeIn .25s ease both;">
            <div style="width:32px;height:32px;background:var(--color-primary);border-radius:10px;margin-bottom:20px;"></div>
            <h1 style="font-size:20px;font-weight:700;margin:0 0 4px;">Welcome back</h1>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:18px;">Sign in to continue.</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);"></label>
                    <input asp-for="Email" class="input-clean" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:11px;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);"></label>
                    <input asp-for="Password" class="input-clean" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:11px;"></span>
                </div>

                <button type="submit" style="background:var(--color-primary);color:white;width:100%;height:42px;border-radius:var(--radius-sm);font-size:14px;font-weight:500;border:none;">Login</button>
                <div style="text-align:center;margin-top:12px;">
                    <a asp-action="Register" style="font-size:13px;color:var(--color-primary);text-decoration:none;">Create account</a>
                </div>
            </form>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>

@model ProjectTeamViewModel
@{
    ViewData["Title"] = "Project Team";
}

<h2 class="mb-3">Team - @Model.ProjectName</h2>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:16px 20px;display:flex;align-items:center;gap:14px;height:100%;">
            <div style="width:48px;height:48px;border-radius:50%;background:var(--color-primary-dark);color:white;font-weight:600;display:flex;align-items:center;justify-content:center;">
                    @Model.SeniorDev.Initials
                </div>
                <div>
                    <div style="font-size:14px;font-weight:600;">@Model.SeniorDev.FullName</div>
                    <small style="font-size:12px;color:var(--color-text-muted);">@Model.SeniorDev.Role</small>
                </div>
        </div>
    </div>

    <div class="col-md-6">
        <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:16px 20px;display:flex;align-items:center;gap:14px;height:100%;">
            <div style="width:48px;height:48px;border-radius:50%;background:var(--color-primary);color:white;font-weight:600;display:flex;align-items:center;justify-content:center;">
                    @Model.Client.Initials
                </div>
                <div>
                    <div style="font-size:14px;font-weight:600;">@Model.Client.FullName</div>
                    <small style="font-size:12px;color:var(--color-text-muted);">@Model.Client.Role</small>
                </div>
        </div>
    </div>
</div>

@if (!Model.Developers.Any())
{
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:16px;">No developers with assigned tasks on this project.</div>
}
else
{
    <div class="team-grid">
        @foreach (var developer in Model.Developers)
        {
            <div class="team-card" style="text-align:left;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="team-avatar" style="margin:0;background:var(--color-primary-light);color:var(--color-primary-dark);">
                                    @developer.Initials
                                </div>
                                <div>
                            <div style="font-size:13px;font-weight:500;">@developer.FullName</div>
                            <small style="font-size:11px;color:var(--color-text-muted);">Weekly score</small>
                                </div>
                            </div>
                    <span style="background:var(--color-success-bg);color:var(--color-success);border-radius:var(--radius-full);padding:2px 8px;font-size:11px;font-weight:500;">@developer.MonthlyScorePercentage.ToString("0.##")%</span>
                </div>

                <div class="table-responsive">
                    <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>Task</th>
                                        <th>Priority</th>
                                        <th>Status</th>
                                        <th>Deadline</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var task in developer.Tasks)
                                {
                                    var priorityBadge = task.Priority switch
                                    {
                                        ProjectManager.Core.Enums.TaskPriority.High => "background:var(--color-warning-bg);color:var(--color-warning);",
                                        ProjectManager.Core.Enums.TaskPriority.Medium => "background:var(--color-primary-light);color:var(--color-primary-dark);",
                                        ProjectManager.Core.Enums.TaskPriority.Low => "background:var(--color-success-bg);color:var(--color-success);",
                                        _ => "background:var(--color-surface-hover);color:var(--color-text-secondary);"
                                    };

                                    <tr>
                                        <td>@task.Title</td>
                                        <td><span style="@priorityBadge border-radius:var(--radius-full);padding:2px 8px;font-size:11px;font-weight:500;">@task.Priority</span></td>
                                        <td>@task.Status</td>
                                        <td>@task.Deadline.ToShortDateString()</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" style="border:1px solid var(--color-border);color:var(--color-text-secondary);padding:6px 12px;border-radius:var(--radius-sm);text-decoration:none;">Back to project</a>
</div>

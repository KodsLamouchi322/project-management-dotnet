@model CreateTaskViewModel
@using ProjectManager.Core.Enums
@{
    var index = ViewData["TaskIndex"]?.ToString() ?? "0";
    var developers = ViewData["Developers"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                     ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var minTaskDate = ViewData["MinTaskDeadline"]?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
    var maxTaskDate = ViewData["MaxTaskDeadline"]?.ToString();
}

<div class="task-row" data-task-index="@index" style="background:var(--color-surface);border:1px solid var(--color-border);border-left:3px solid var(--color-primary-mid);border-radius:var(--radius-md);padding:16px;margin-bottom:10px;position:relative;">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;">Title</label>
            <input class="input-clean" name="Tasks[@index].Title" value="@Model.Title" />
            @Html.ValidationMessage($"Tasks[{index}].Title", string.Empty, new { @class = "text-danger d-block", style = "font-size:12px;" })
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;">Priority</label>
            <select class="select-clean" name="Tasks[@index].Priority">
                @foreach (TaskPriority p in Enum.GetValues(typeof(TaskPriority)))
                {
                    if (Model.Priority == p)
                    {
                        <option value="@((int)p)" selected="selected">@p</option>
                    }
                    else
                    {
                        <option value="@((int)p)">@p</option>
                    }
                }
            </select>
            @Html.ValidationMessage($"Tasks[{index}].Priority", string.Empty, new { @class = "text-danger d-block", style = "font-size:12px;" })
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;">Description</label>
        <textarea class="textarea-clean" name="Tasks[@index].Description">@Model.Description</textarea>
        @Html.ValidationMessage($"Tasks[{index}].Description", string.Empty, new { @class = "text-danger d-block", style = "font-size:12px;" })
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;">Deadline</label>
            @if (string.IsNullOrEmpty(maxTaskDate))
            {
                <input type="date" class="input-clean" name="Tasks[@index].Deadline" min="@minTaskDate" value="@(Model.Deadline != default ? Model.Deadline.ToString("yyyy-MM-dd") : "")" />
            }
            else
            {
                <input type="date" class="input-clean" name="Tasks[@index].Deadline" min="@minTaskDate" max="@maxTaskDate" value="@(Model.Deadline != default ? Model.Deadline.ToString("yyyy-MM-dd") : "")" />
            }
            @Html.ValidationMessage($"Tasks[{index}].Deadline", string.Empty, new { @class = "text-danger d-block", style = "font-size:12px;" })
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;">Duration</label>
            <input type="time" class="input-clean" step="60" name="Tasks[@index].Duration" value="@Model.Duration.ToString(@"hh\:mm")" />
            @Html.ValidationMessage($"Tasks[{index}].Duration", string.Empty, new { @class = "text-danger d-block", style = "font-size:12px;" })
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label" style="font-size:12px;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;">Developer</label>
            <select class="select-clean" name="Tasks[@index].DeveloperId">
                <option value="">-- Select Developer --</option>
                @foreach (var developer in developers)
                {
                    if (developer.Value == Model.DeveloperId)
                    {
                        <option value="@developer.Value" selected="selected">@developer.Text</option>
                    }
                    else
                    {
                        <option value="@developer.Value">@developer.Text</option>
                    }
                }
            </select>
            @Html.ValidationMessage($"Tasks[{index}].DeveloperId", string.Empty, new { @class = "text-danger d-block", style = "font-size:12px;" })
        </div>
    </div>

    <button type="button" class="remove-task-btn" style="position:absolute;top:10px;right:10px;font-size:18px;color:var(--color-text-muted);background:none;border:none;cursor:pointer;line-height:1;">×</button>
</div>

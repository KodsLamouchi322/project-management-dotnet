@model ProjectFormViewModel
@{
    ViewData["Title"] = "Edit Project";
    ViewData["IsProjectCreate"] = false;
}

<h2>Edit Project</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <span asp-validation-for="Tasks" class="text-danger d-block mb-2"></span>
    <partial name="_ProjectForm" model="Model" />

    <hr />
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Project Tasks</h4>
        <a asp-controller="Task" asp-action="AddTask" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-primary">Add Task</a>
    </div>

    @if (!Model.Tasks.Any())
    {
        <p class="text-muted">No tasks assigned to this project.</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Developer</th>
                        <th>Status</th>
                        <th>Deadline</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td>@task.Title</td>
                        <td>@task.DeveloperName</td>
                        <td>@task.Status</td>
                        <td>@task.Deadline.ToShortDateString()</td>
                        <td class="text-end">
                            <a asp-controller="Task" asp-action="EditTask" asp-route-id="@task.TaskId" class="btn btn-sm btn-secondary">Edit Task</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model IReadOnlyList<ProjectManager.Core.Entities.Notification>
@{
    ViewData["Title"] = "All Notifications";
}

<h2 class="mb-3">All Notifications</h2>

@if (!Model.Any())
{
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:16px;">No notifications.</div>
}
else
{
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);overflow:hidden;">
        @foreach (var notification in Model)
        {
            var itemStyle = notification.IsRead
                ? "border-left:3px solid var(--color-border);"
                : "border-left:3px solid var(--color-primary);background:var(--color-primary-light);";
            var messageStyle = notification.IsRead
                ? "font-weight:400;color:var(--color-text-secondary);"
                : "font-weight:500;color:var(--color-text-primary);";
            var badgeStyle = notification.IsRead
                ? "background:var(--color-surface-hover);color:var(--color-text-secondary);"
                : "background:var(--color-primary-light);color:var(--color-primary-dark);";

            <div style="display:flex;justify-content:space-between;align-items:flex-start;padding:14px 16px;border-bottom:1px solid var(--color-border);@itemStyle">
                <div>
                    <div style="font-size:13px;@messageStyle">@notification.Message</div>
                    <small style="font-size:11px;color:var(--color-text-muted);margin-top:3px;display:block;">@notification.CreatedAt.ToString("g")</small>
                </div>
                <span style="@badgeStyle border-radius:var(--radius-full);padding:2px 8px;font-size:11px;font-weight:500;">@(notification.IsRead ? "Read" : "Unread")</span>
            </div>
        }
    </div>
}

@model TaskFormViewModel
@{
    var minDeadline = Model.ProjectStartDate.Date.AddDays(1);
    var maxDeadline = Model.ProjectDeadline.Date;
}

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ProjectManager.Core.Enums.TaskPriority>()" class="form-select"></select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Deadline" class="form-label"></label>
        <input asp-for="Deadline" type="date" class="form-control" min="@minDeadline.ToString("yyyy-MM-dd")" max="@maxDeadline.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Deadline" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Duration" class="form-label"></label>
        <input asp-for="Duration" type="time" class="form-control" step="60" />
        <span asp-validation-for="Duration" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="DeveloperId" class="form-label"></label>
    <select asp-for="DeveloperId" asp-items="Model.Developers" class="form-select">
        <option value="">-- Select Developer --</option>
    </select>
    <span asp-validation-for="DeveloperId" class="text-danger"></span>
</div>
